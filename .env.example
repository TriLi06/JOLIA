# JOLIA Docs – optionale App-Overrides innerhalb der verwalteten WSL-Installation.
# Diese Datei ist eine Referenzvorlage, kein eigenständiger Installer.
# Der WSL-Installer verwaltet Speicherpfade und Port. Änder die Pfade nicht hier.
# Alles Auskommentierte behält den Standardwert.

# ===========================================================================
# NOTFALL-SCHALTER
#    Nur setzen, wenn eine Funktion Probleme macht oder zu langsam ist.
#    Boolesche Werte: true/false (auch 1/0, yes/no, on/off).
#    Ein ungültiger Wert wird ignoriert und im Log als Warnung gemeldet.
# ===========================================================================

# --- Funktionen abschalten -------------------------------------------------
# Gesichtserkennung (sehr CPU-intensiv bei vielen Fotos)
# JOLIA_ENABLE_FACE_DETECTION=false
# Bildähnlichkeitssuche (CLIP)
# JOLIA_ENABLE_CLIP_EMBEDDINGS=false
# Audio-/Musikähnlichkeitssuche (CLAP; lädt Modell von HuggingFace)
# JOLIA_ENABLE_CLAP_EMBEDDINGS=false
# Audio-/Video-Transkription (Whisper; langsamste Funktion auf der CPU)
# JOLIA_ENABLE_AUDIO_TRANSCRIPTION=false
# JOLIA_ENABLE_VIDEO_TRANSCRIPTION=false
# KI-Zusammenfassung von Transkripten (braucht Ollama)
# JOLIA_ENABLE_MEDIA_SUMMARIZATION=false
# Automatische Tag-Vorschläge (braucht Ollama)
# JOLIA_ENABLE_TAG_SUGGESTION=false
# Texterkennung in PDFs bzw. in Bildern
# JOLIA_ENABLE_OCR=false
# JOLIA_ENABLE_IMAGE_OCR=false

# --- Leistung anpassen -----------------------------------------------------
# Gleichzeitig verarbeitete Dateien (weniger = ruhigerer Rechner)
# JOLIA_MAX_CONCURRENT_PROCESSING=1
# Größere Dateien werden übersprungen
# JOLIA_MAX_FILE_SIZE_MB=500
# Nur die ersten N Sekunden transkribieren (0 = ganze Datei)
# JOLIA_TRANSCRIPTION_SAMPLE_SECONDS=30
# Whisper-Modellgröße: tiny | base | small | medium | large
# JOLIA_WHISPER_MODEL=tiny
# OCR-Sprachen (Tesseract-Codes, im Image enthalten: deu, eng)
# JOLIA_OCR_LANGUAGES=deu+eng
# Anderes Textmodell für Chat/Zusammenfassungen.
# Modellwechsel und notwendige Downloads über die verwaltete WSL-Installation durchführen.
# OLLAMA_MODEL=qwen2.5:1.5b
# Zeitlimit pro LLM-Anfrage in Sekunden (bei langsamer CPU erhöhen)
# JOLIA_OLLAMA_TIMEOUT=600

# --- Automatischer Import und Hintergrundjobs ------------------------------
# Automatischen Inbox-Import abschalten (dann nur Upload über die Weboberfläche)
# JOLIA_WATCHER_ENABLED=false
# Prüfintervall des Inbox-Ordners in Sekunden
# JOLIA_WATCHER_INTERVAL_SECONDS=60
# Nächtliches Clustering (Gesichter/Orte/Duplikate) abschalten
# JOLIA_CLUSTERING_ENABLED=false
# Automatisches Backup abschalten bzw. Intervall ändern (86400 = täglich)
# JOLIA_BACKUP_ENABLED=false
# JOLIA_BACKUP_INTERVAL_SECONDS=86400

# --- Netzwerkzugriff ------------------------------------------------------
# Die unterstützte WSL-Installation stellt bewusst KEINEN Login und KEIN
# Passwort bereit. Nur in einem sicheren, vertrauenswürdigen Heimnetz betreiben.
# Nicht in Gast-/öffentlichen/Firmennetzen oder über Portweiterleitungen nutzen.

# --- Diagnose --------------------------------------------------------------
# Ausführliche Logs
# DEBUG=true
