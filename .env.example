# DocStoreAI – Umgebungsvariablen (Entwicklung Windows)
# Diese Datei als .env kopieren und anpassen.

# Pfade (überschreiben config.yaml)
INBOX_PATH=C:/dev/docstoreai-test/inbox
ARCHIVE_ROOT=C:/dev/docstoreai-test/source_documents
