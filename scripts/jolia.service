[Unit]
Description=JOLIA Docs – Turn Documents, Photos and Scans into Knowledge.
After=network.target

[Service]
Type=simple
User=archive
Group=archive
WorkingDirectory=/home/archive/jolia
EnvironmentFile=/home/archive/jolia/.env
ExecStart=/home/archive/jolia/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jolia

# Ressourcenlimits (optional anpassen)
# LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
